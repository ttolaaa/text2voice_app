# Copy to .env (never commit .env). docker compose reads it automatically.

# Host port for the app. When using the HTTPS proxy below, use 127.0.0.1:8080 so the app is only reachable through it.
PORT=8080

# ---- Optional: automatic HTTPS with Caddy (needed for phones: microphone, fast voices) ----
# Point your domain's DNS (A/AAAA record) at this server and open ports 80 and 443, then uncomment:
# COMPOSE_PROFILES=https
# DOMAIN=voice.example.com
# TRUST_PROXY=1
# PORT=127.0.0.1:8080

# ---- Optional: Azure AI Speech neural voices ----
# Azure portal -> Speech service -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional limits for the Azure proxy (per client IP)
# AZURE_REQUESTS_PER_MINUTE=30
# AZURE_CHARS_PER_HOUR=60000

# ---- "My Voice" cloning service ----
# Leave CLONE_URL unset to use the bundled container; set it empty (CLONE_URL=) to disable My Voice.
# CLONE_URL=
# CLONE_DEVICE=auto   # auto | cpu | cuda
# CLONE_MODEL=turbo   # turbo (about 2x faster) | standard (slower, adds the Expressiveness control)
