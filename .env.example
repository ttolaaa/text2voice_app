# Copy to .env (never commit .env). docker compose reads it automatically.

# Host port for the app
PORT=8080

# Optional: Azure AI Speech neural voices (https://portal.azure.com -> Speech service -> Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional limits for the Azure proxy (per client IP)
# AZURE_REQUESTS_PER_MINUTE=30
# AZURE_CHARS_PER_HOUR=60000

# "My Voice" cloning service. Leave CLONE_URL unset to use the bundled container; set it empty to disable.
# CLONE_URL=
# CLONE_DEVICE=auto   # auto | cpu | cuda
# CLONE_MODEL=turbo   # turbo (≈2x faster) | standard (slower, adds the Expressiveness control)

# Set when running behind a reverse proxy so rate limits use the real client IP
# TRUST_PROXY=1
